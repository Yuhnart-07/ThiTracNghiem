extends ../layouts/default.pug
include ../mixins/breadcrumb.pug
include ../mixins/product-item.pug

block main
  +breadcrumb()

  // SECTION 10
  .section-10
    .container
      .inner-wrap

        .inner-left

          // BOX IMAGE
          .box-image
            .inner-image-main
              .swiper.swiperImageMain
                .swiper-wrapper

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-6.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-2.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-3.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-4.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-5.jpg"
                      )

            .inner-image-thumb
              .swiper.swiperImageThumb
                .swiper-wrapper

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-6.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-2.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-3.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-4.jpg"
                      )

                  .swiper-slide
                    .inner-image
                      img(
                        alt=""
                        src="/client/assets/img/section10-5.jpg"
                      )

          // END BOX IMAGE

          // BOX TOUR INFO
          .box-tour-info
            .inner-title-main Thông Tin Tour

            .inner-content
              p
                | Nói về dịch vụ, chắc chắn rồi, với một tiêu chí của một khách sạn 5 sao đẳng cấp, mình tin rằng Indochine Palace đủ để cho bạn đánh giá 6 sao.

              img(
                alt=""
                src="/client/assets/img/section10-2.jpg"
              )

              p
                | Từ nhà hàng, cà phê, đến trung tâm thể dục thể thao hiện đại đến Spa, xông hơi… tất tần tật các dịch vụ mà bạn mong muốn đều có ở đây.

              img(
                alt=""
                src="/client/assets/img/section10-2.jpg"
              )

            .inner-read-more
              button.button-outline Xem tất cả

          // END BOX TOUR INFO

          // BOX TOUR SCHEDULE
          .box-tour-schedule
            .inner-title-main Lịch Trình Tour

            .inner-list
              .inner-line

              .inner-item
                .inner-dot

                .inner-title
                  | NGÀY 1 | TP.HCM – THỦ ĐÔ HÀ NỘI

                .inner-content
                  p
                    | Sáng: HDV TOPTEN TRAVEL® Đón Quý Khách tại sân bay Tân Sơn Nhất làm thủ tục check in cho đoàn đi Hà Nội.

                  img(
                    alt=""
                    src="/client/assets/img/section10-5.jpg"
                  )

              .inner-item
                .inner-dot

                .inner-title
                  | NGÀY 2 | TP.HCM – THỦ ĐÔ HÀ NỘI

                .inner-content
                  p
                    | Sáng: HDV TOPTEN TRAVEL® Đón Quý Khách tại sân bay Tân Sơn Nhất làm thủ tục check in cho đoàn đi Hà Nội.

                  img(
                    alt=""
                    src="/client/assets/img/section10-5.jpg"
                  )

          // END BOX TOUR SCHEDULE

        .inner-right

          // BOX TOUR DETAIL
          .box-tour-detail

            .inner-title-main
              | Chuyến Đi Của Bạn

            .inner-product

              .inner-image
                img(
                  alt=""
                  src="/client/assets/img/section10-6.jpg"
                )

              .inner-info

                .inner-title
                  | Hà Nội - Ninh Bình - Hạ Long - Yên Tử - Sapa | 6N5D

                .inner-rating

                  .inner-stars
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star-half-stroke

                  .inner-number
                    | 500 lượt đánh giá

            .inner-meta

              .inner-item
                i.fa-solid.fa-ticket-simple
                span Mã Tour:
                span.inner-highlight 28T00001

              .inner-item
                i.fa-solid.fa-calendar-days
                span Thời Gian:
                span.inner-highlight 6 Ngày 5 Đêm

              .inner-item
                i.fa-solid.fa-car
                span Phương Tiện:
                span.inner-highlight Ô tô 45 chỗ

              .inner-item
                i.fa-solid.fa-calendar-days
                span Ngày Khởi Hành:
                span.inner-highlight 20/10/2024

            .inner-group
              .inner-label Khởi Hành Tại:

              select
                option(value="") Hà Nội
                option(value="") TPHCM
                option(value="") Đà Nẵng
                option(value="") Hội An

            .inner-group

              .inner-label
                | Số Lượng Hành Khách

              .inner-list

                .inner-item

                  .inner-item-label
                    | Người lớn:

                  .inner-item-input
                    input(type="number")

                  .inner-item-price
                    span 1
                    span x
                    span.inner-highlight 10.000.000

                .inner-item

                  .inner-item-label
                    | Trẻ em:

                  .inner-item-input
                    input(type="number")

                  .inner-item-price
                    span 0
                    span x
                    span.inner-highlight 7.990.000

                .inner-item

                  .inner-item-label
                    | Em bé:

                  .inner-item-input
                    input(type="number")

                  .inner-item-price
                    span 0
                    span x
                    span.inner-highlight 5.990.000

            .inner-total
              .inner-label Tổng cộng:
              .inner-price 10.000.000 đ

            button.inner-button
              | Thêm Vào Giỏ Hàng

          // END BOX TOUR DETAIL

  // END SECTION 10