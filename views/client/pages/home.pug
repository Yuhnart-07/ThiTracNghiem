extends ../layouts/default.pug
include ../mixins/product-item.pug


block main 
  // SECTION 1
  .section-1
    .container
      .inner-wrap
        h1.box-title(
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | Du lịch Châu Á - Khám phá Mỹ, Úc, Âu
          br
          | Đi nơi đâu bạn muốn
        p.inner-subtitle(
          data-aos-delay="200" 
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua
        form.inner-form(
          data-aos-delay="400" 
          data-aos-duration="800" 
          data-aos="fade-up" 
          action=""
          )
          .inner-address.inner-box
            .inner-group
              img.inner-icon(
                alt="" 
                src="/client/assets/img/section1-1.png"
                )
              input.inner-input(
                placeholder="Bạn muốn đi đâu?" 
                type="text"
                )
              i.fa-solid.fa-angle-down.inner-down
            .inner-suggest
              .inner-suggest-title
                i.fa-solid.fa-location-dot
                | Địa Điểm Hot
              .inner-suggest-list
                .inner-item
                  .inner-item-image
                    img(
                      alt="" 
                      src="/assets/img/Rectangle 1025.png"
                      )
                  .inner-item-content
                    .inner-item-title Nhật Bản
                    .inner-item-desc 50 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt="" 
                      src="/assets/img/Rectangle 1025.png"
                      )
                  .inner-item-content
                    .inner-item-title Phú Quốc
                    .inner-item-desc 30 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt="" 
                      src="/assets/img/Rectangle 1025.png"
                      )
                  .inner-item-content
                    .inner-item-title Hàn Quốc
                    .inner-item-desc 35 tours
                .inner-item
                  .inner-item-image
                    img(
                      alt="" 
                      src="/assets/img/Rectangle 1025.png"
                      )
                  .inner-item-content
                    .inner-item-title Đức
                    .inner-item-desc 20 tours
          .inner-user.inner-box
            .inner-group
              img.inner-icon(
                alt="" 
                src="/client/assets/img/section1-2.png"
                )
              input.inner-input(
                readonly="" 
                placeholder="Số lượng" 
                type="text"
                )
              i.fa-solid.fa-angle-down.inner-down
            .inner-quantity
              .inner-item
                .inner-label Người lớn
                .inner-count
                  span.inner-down -
                  span.inner-number 1
                  span.inner-up +
              .inner-item
                .inner-label Trẻ em
                .inner-count
                  span.inner-down -
                  span.inner-number 0
                  span.inner-up +
              .inner-item
                .inner-label Em bé
                .inner-count
                  span.inner-down -
                  span.inner-number 0
                  span.inner-up +
          .inner-calender.inner-box
            .inner-group
              img.inner-icon(
                alt="" 
                src="/client/assets/img/section1-3.png"
                )
              input.inner-input(
                placeholder="Lịch khởi hành" 
                type="text"
                )
              i.fa-solid.fa-angle-down.inner-down
          button.inner-button
            i.fa-solid.fa-magnifying-glass
            | Tìm Kiếm
  // END SECTION 1
  // SECTION 2
  .section-2
    .container
      .inner-wrap
        .inner-info
          h2.inner-title(
            data-aos-duration="800" 
            data-aos="fade-up"
            )
            | ƯU ĐÃI 2024
            br
            | TOUR GIỜ CHÓT
          p.inner-subtitle(
            data-aos-delay="200" 
            data-aos-duration="800" 
            data-aos="fade-up"
            ) Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          .inner-clock-title(
            data-aos-delay="400" 
            data-aos-duration="800" 
            data-aos="fade-up"
            ) Kết thúc sau
          .inner-clock-number(
            data-aos-delay="400" 
            data-aos-duration="800" 
            data-aos="fade-up" 
            clock-expire="2026-04-14T22:00:00"
            )
            .inner-item
              .inner-number 00
              .inner-label Ngày
            .inner-item
              .inner-number 00
              .inner-label Giờ
            .inner-item
              .inner-number 00
              .inner-label Phút
            .inner-item
              .inner-number 00
              .inner-label Giây
          .inner-discount-title(
            data-aos-delay="500" 
            data-aos-duration="800" 
            data-aos="fade-up"
            ) GIẢM ĐẾN
          .inner-discount-price(
            data-aos-delay="500" 
            data-aos-duration="800" 
            data-aos="fade-up"
            )
            | 990.000
            span đ
        .inner-list(
          data-aos-delay="600" 
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          .swiper.swiperSection2
            .swiper-wrapper
              .swiper-slide
                +product-item()
              .swiper-slide
                +product-item()
              .swiper-slide
                +product-item()
              .swiper-slide
                +product-item()
  // END SECTION 2
  // SECTION 3
  .section-3
    .container
      h1.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Khuyến Mại Bùng Nổ - Đánh Tan Nóng Bức
      .inner-list(
        data-aos-delay="200" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        .swiper.swiperSection3
          .swiper-wrapper
            .swiper-slide
              .inner-image
                a(href="#")
                  img(
                    alt="" 
                    src="/client/assets/img/section3.png"
                    )
            .swiper-slide
              .inner-image.active1
                a(href="#")
                  img(
                    alt="" 
                    src="/client/assets/img/section3.png"
                    )
            .swiper-slide
              .inner-image.active2
                a(href="#")
                  img(
                    alt="" 
                    src="/client/assets/img/section3.png"
                    )
            .swiper-slide
              .inner-image.active2
                a(href="#")
                  img(
                    alt="" 
                    src="/client/assets/img/section3.png"
                    )
          .swiper-pagination
  // END SECTION 3
  // SECTION 4
  .section-4
    .container
      h2.box-title(
        d="" 
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Tour Trong Nước
      .inner-list(
        data-aos-delay="200" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        +product-item()
      .inner-button
        a.button-outline(href="#") Xem tất cả
  // END SECTION 4
  // SECTION 5
  .section-5(
    data-aos-duration="800" 
    data-aos="fade-up"
    )
    .container
      a.inner-image(href="#")
        img(
          alt="" 
          src="/client/assets/img/BG-section5.png"
          )
  // END SECTION 5
  // SECTION-6
  .section-4
    .container
      h2.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Tour Nước Ngoài
      .inner-list(
        data-aos-delay="200" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        +product-item()
      .inner-button
        a.button-outline(href="#") Xem tất cả
  // END SECTION 6
  // SECTION-7
  .section-5(
    data-aos-duration="800" 
    data-aos="fade-up"
    )
    .container
      a.inner-image(href="#")
        img(
          alt="" 
          src="/client/assets/img/BG-section7.png"
          )
  // END SECTION 7
  // SECTION 8
  .section-8
    .container
      h2.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Tin Tức Mới
      .inner-list(
        data-aos-delay="200" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        .blog-item-1
          a.inner-image(href="#")
            img(
              alt="" 
              src="/client/assets/img/blog-1.png"
              )
          .inner-contents
            .inner-date 23/05/2024
            h3.inner-title Homestay “cổ tích” giữa Đà Lạt mộng mơ
        .blog-item-2
          a.inner-image(href="#")
            img(
              alt="" 
              src="/client/assets/img/blog-2.png"
              )
          .inner-contents
            .inner-date 23/05/2024
            h3.inner-title Top 5 điểm check in độc đáo tại Singapore
            .inner-sub
              | Nếu bạn nghĩ du lịch Singapore rất nhàm chán vì chỉ mãi quanh quẩn trong những khối bê tông vô cảm thì bạn “chắc chưa?”. Tuy đảo quốc Sư Tử không phải là một quốc gia rộng lớn nhưng các địa điểm du lịch tại Singapore chưa từng đánh mất sức hút đối với cộng đồng xê dịch quốc tế.
        .blog-item-1
          a.inner-image(href="#")
            img(
              alt="" 
              src="/client/assets/img/blog-5.png"
              )
          .inner-contents
            .inner-date 23/05/2024
            h3.inner-title Đảo Phú Quý Bình Thuận hot trend năm 2024
        .blog-item-1
          a.inner-image(href="#")
            img(
              alt="" 
              src="/client/assets/img/blog-3.png"
              )
          .inner-contents
            .inner-date 23/05/2024
            h3.inner-title(title="Đặc sản không thể bỏ qua khi đến với Đà Nẵng – Hội An") Đặc sản không thể bỏ qua khi đến với Đà Nẵng – Hội An
        .blog-item-1
          a.inner-image(href="#")
            img(
              alt="" 
              src="/client/assets/img/blog-4.png"
              )
          .inner-contents
            .inner-date 23/05/2024
            h3.inner-title(title="Trekking cắm trại tại Đà Lạt- Cảm nhận Đà Lạt qua từng bước chân") Trekking cắm trại tại Đà Lạt- Cảm nhận Đà Lạt qua từng bước chân
  // END SECTION 8
