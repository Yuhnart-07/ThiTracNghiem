mixin product-item()
	.product-item
		.inner-image
			a(href="#")
				img(
					alt="" 
					src="/client/assets/img/Rectangle 1025.png"
					)
		.inner-discount
			i.fa-solid.fa-bolt
			| Giảm -30%
		.inner-contents
			.inner-location Hà Nội – Lào Cai – SaPa 4N3Đ
			.inner-prices
				.inner-price-old
					| 13.650.000
					span.inner-unit đ
				.inner-price-new
					| 2.590.000
					span.inner-unit đ
			.inner-desc
				div
					| Mã Tour:
					b 123456789
				div
					| Ngày Khởi Hành:
					b 22/07/2024
				div
					| Thời Gian:
					b 10 Ngày 9 Đêm
			.inner-meta
				.inner-rating
					.inner-stars
						i.fa-solid.fa-star
						i.fa-solid.fa-star
						i.fa-solid.fa-star
						i.fa-solid.fa-star
						i.fa-regular.fa-star
					.inner-number (5)
				.inner-seating
					.inner-label Số chỗ còn:
					.inner-number 10