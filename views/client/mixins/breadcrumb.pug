mixin breadcrumb()
	// BREADCRUMB
	.breadcrumb
		.inner-image
			img(
			alt="" 
			src="/client/assets/img/Breadcrumb.jpg"
			)
		.inner-content
			.container
				.inner-wrap
					h1.inner-title Tour Nước Ngoài
					nav.inner-links
					a(href="#") Trang Chủ
					i.fa-solid.fa-angles-right
					a(href="#") Tour Nước Ngoài
		// END BREADCRUMB