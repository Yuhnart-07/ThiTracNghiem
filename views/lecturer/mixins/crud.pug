mixin crud()
	.section-2
		.inner-wrap
			.inner-left
				span.inner-badge(id="modeBadge")
					| ĐANG XEM

				.inner-divider

				button.inner-button.inner-button-primary(
					type="button"
					id="btnAdd"
				)
					span.material-symbols-outlined
						| add
					span Thêm

				button.inner-button.disabled(
					type="button"
					id="btnEdit"
					disabled
				)
					span.material-symbols-outlined
						| edit
					span Hiệu chỉnh

				button.inner-button.disabled(
					type="button"
					id="btnDelete"
					disabled
				)
					span.material-symbols-outlined
						| delete
					span Xóa

				button.inner-button.disabled(
					type="button"
					id="btnUndo"
					disabled
				)
					span.material-symbols-outlined
						| undo
					span Phục hồi

				button.inner-button.disabled(
					type="button"
					id="btnExitMode"
					disabled
				)
					span.material-symbols-outlined
						| close
					span Thoát

			.inner-right
				button.inner-button.disabled(
					type="button"
					id="btnSave"
					disabled
				)
					span.material-symbols-outlined
						| save
					span Ghi
