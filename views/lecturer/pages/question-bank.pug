extends ../layouts/default.pug
include ../mixins/crud.pug

block main
	- const canMutateQuestions = currentUser && currentUser.role === "GIANGVIEN";
	- const initialSubjects = subjects || [];

	// SECTION 4
	.section-1
		form.inner-form(
			id="questionBankForm"
			data-can-mutate=canMutateQuestions ? "true" : "false"
			data-user-role=currentUser ? currentUser.role : ""
		)
			input(type="hidden" id="questionId" name="questionId" value="")
			.question-bank-message(id="questionBankMessage" role="status")

			.inner-wrap
				// LEFT COLUMN
				.inner-left
					.group-item
						label.inner-label(for="subjectSelect")
							| Môn học
							span.inner-required *

						select.inner-select(
							id="subjectSelect"
							name="subject"
							required
						)
							option(value="")
								| Chọn môn học
							each subject in initialSubjects
								option(value=subject.maMonHoc)
									| #{subject.maMonHoc} - #{subject.tenMonHoc}

						p.inner-help
							| Chọn từ danh sách môn học trong hệ thống.

					.group-item
						label.inner-label
							| Vai trò hiện tại

						input.inner-control.control-readonly(
							type="text"
							value=currentUser ? currentUser.role : "Chưa đăng nhập"
							readonly
						)

					.group-item
						label.inner-label
							| Trình độ 
							span.inner-required *
						//- LEVEL LIST
						.level-list

							.level-item
								input(
									type="radio"
									name="level"
									value="A"
								)

								.level-box
									| A

							.level-item
								input(
									type="radio"
									name="level"
									value="B"
									checked
								)

								.level-box
									| B

							.level-item
								input(
									type="radio"
									name="level"
									value="C"
								)

								.level-box
									| C

				// RIGHT COLUMN
				.inner-right

					.group-item
						label.inner-label(for="questionContent")
							| Nội dung 
							span.inner-required *

						textarea.textarea(
							id="questionContent"
							name="questionContent"
							rows="4"
							placeholder="Nhập nội dung câu hỏi..."
							maxlength="500"
							required
						)
					//- ANSWER LIST
					.answer-list

						// ANSWER A
						.answer-item

							label.inner-label(for="answerA")
								| Đáp án A
								span.inner-required *

							.answer-wrap

								input.answer-radio(
									type="radio"
									name="correctAnswer"
									value="A"
								)

								input.inner-control(
									type="text"
									id="answerA"
									name="answerA"
									maxlength="200"
									required
								)

						// ANSWER B
						.answer-item

							label.inner-label(for="answerB")
								| Đáp án B
								span.inner-required *

							.answer-wrap

								input.answer-radio(
									type="radio"
									name="correctAnswer"
									value="B"
								)

								input.inner-control(
									type="text"
									id="answerB"
									name="answerB"
									maxlength="200"
									required
								)

						// ANSWER C
						.answer-item

							label.inner-label(for="answerC")
								| Đáp án C
								span.inner-required *

							.answer-wrap

								input.answer-radio(
									type="radio"
									name="correctAnswer"
									value="C"
									checked
								)

								input.inner-control(
									type="text"
									id="answerC"
									name="answerC"
									maxlength="200"
									required
								)

						// ANSWER D
						.answer-item

							label.inner-label(for="answerD")
								| Đáp án D
								span.inner-required *

							.answer-wrap

								input.answer-radio(
									type="radio"
									name="correctAnswer"
									value="D"
								)

								input.inner-control(
									type="text"
									id="answerD"
									name="answerD"
									maxlength="200"
									required
								)

	+crud()

	// SECTION 3 - TABLE
	.section-3

		.inner-head

			h2.inner-title-main
				span.inner-dot
				span DANH SÁCH CÂU HỎI

			.inner-tools

				.inner-filter
					button.inner-filter-search(
						type="button"
						id="btnKeywordSearch"
						aria-label="Tìm câu hỏi"
						title="Tìm câu hỏi"
					)
						span.material-symbols-outlined
							| search

					input.inner-filter-input(
						type="text"
						id="tableFilter"
						placeholder="Tìm kiếm..."
					)

				button.inner-filter-button(
					type="button"
					id="btnToggleFilters"
					aria-label="Bộ lọc câu hỏi"
					title="Bộ lọc câu hỏi"
				)
					span.material-symbols-outlined
						| filter_list

		.question-filter-panel(id="questionFilterPanel" hidden)
			.filter-grid
				.group-item
					label.inner-label(for="filterSubject")
						| Lọc theo môn học

					select.inner-select(
						id="filterSubject"
					)
						option(value="")
							| Tất cả môn học
						each subject in initialSubjects
							option(value=subject.maMonHoc)
								| #{subject.maMonHoc} - #{subject.tenMonHoc}

				.group-item
					label.inner-label(for="filterLevel")
						| Lọc theo trình độ

					select.inner-select(
						id="filterLevel"
					)
						option(value="")
							| Tất cả trình độ
						option(value="A")
							| A
						option(value="B")
							| B
						option(value="C")
							| C

				.filter-actions
					button.inner-button.inner-button-primary(
						type="button"
						id="btnApplyFilters"
					)
						span.material-symbols-outlined
							| search
						span Tìm

					button.inner-button(
						type="button"
						id="btnClearFilters"
					)
						span.material-symbols-outlined
							| restart_alt
						span Xóa lọc

			.filter-summary(id="filterSummary")
				span.material-symbols-outlined
					| filter_list
				span Chưa áp dụng bộ lọc

		.table-2

			table

				thead
					tr
						th.text-left Mã câu hỏi
						th.text-left Tên môn học
						th.text-left Trình độ
						th.text-left Nội dung câu hỏi
						th.text-left Đáp án
						th.text-left Trạng thái

				tbody#recordsTableBody
					tr
						td(colspan="6" class="text-center")
							| Đang tải dữ liệu...

		// PAGINATION
		.inner-pagination

			p.inner-pagination-text
				| Đang tải 0 câu hỏi

			.inner-pagination-buttons

				button.inner-page-button(
					type="button"
					id="btnPrevPage"
				)
					span.material-symbols-outlined
						| chevron_left

				.inner-page-list(
					id="pageList"
				)

				button.inner-page-button(
					type="button"
					id="btnNextPage"
				)
					span.material-symbols-outlined
						| chevron_right

block scripts
	script(src="/lecturer/assets/js/question-bank.js")
