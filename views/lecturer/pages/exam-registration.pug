extends ../layouts/default.pug
include ../mixins/crud.pug

block main
	- const canMutate = currentUser && currentUser.role === "GIANGVIEN"
	.section-1
		form.inner-form#examRegistrationForm(data-can-mutate=canMutate ? "true" : "false" data-api-base="/lecturer/exam-registration")
			input(type="hidden" id="originalSubject")
			input(type="hidden" id="originalClass")
			input(type="hidden" id="originalAttempt")
			.question-bank-message#examRegistrationMessage(role="status")
			.inner-wrap
				.group-item
					label.inner-label(for="classSelect") Tên lớp #[span.inner-required *]
					select.inner-select#classSelect(required)
						option(value="") Chọn lớp
						each item in classes
							option(value=item.maLop) #{item.maLop} - #{item.tenLop}
				.group-item
					label.inner-label(for="subjectSelect") Môn học #[span.inner-required *]
					select.inner-select#subjectSelect(required)
						option(value="") Chọn môn học
						each item in subjects
							option(value=item.maMonHoc) #{item.maMonHoc} - #{item.tenMonHoc}
				.group-item
					label.inner-label(for="levelSelect") Trình độ #[span.inner-required *]
					select.inner-select#levelSelect(required)
						option(value="A") A
						option(value="B") B
						option(value="C") C
				.group-item
					label.inner-label(for="attemptInput") Lần thi #[span.inner-required *]
					input.inner-control#attemptInput(type="number" min="1" max="2" value="1" required)
				.group-item
					label.inner-label(for="questionCountInput") Số câu thi #[span.inner-required *]
					input.inner-control#questionCountInput(type="number" min="10" max="100" value="20" required)
				.group-item
					label.inner-label(for="examDateInput") Ngày và giờ thi #[span.inner-required *]
					input.inner-control#examDateInput(type="datetime-local" required)
				.group-item
					label.inner-label(for="durationInput") Thời gian (phút) #[span.inner-required *]
					input.inner-control#durationInput(type="number" min="5" max="60" value="30" required)
				.group-item
					label.inner-label Vai trò
					input.inner-control.control-readonly(value=currentUser ? currentUser.role : "" readonly)
			.availability-status#questionAvailabilityStatus(data-state="idle" aria-live="polite")
				span.material-symbols-outlined#availabilityIcon hourglass_empty
				span#availabilityText Chọn môn học, trình độ và số câu để hệ thống tự kiểm tra.

	+crud()

	.section-3
		.inner-head
			h2.inner-title-main
				span.inner-dot
				span DANH SÁCH ĐĂNG KÝ THI
			.inner-tools
				.inner-filter
					button.inner-filter-search#btnKeywordSearch(type="button" aria-label="Tìm đăng ký" title="Tìm đăng ký")
						span.material-symbols-outlined search
					input.inner-filter-input#tableFilter(type="text" placeholder="Tìm lớp hoặc môn học...")
				button.inner-filter-button#btnToggleFilters(type="button" aria-label="Bộ lọc đăng ký" title="Bộ lọc đăng ký")
					span.material-symbols-outlined filter_list
		.registration-filter-panel#registrationFilterPanel(hidden)
			.filter-grid
				.group-item
					label.inner-label(for="filterClass") Lọc theo lớp
					select.inner-select#filterClass
						option(value="") Tất cả lớp
						each item in classes
							option(value=item.maLop) #{item.maLop} - #{item.tenLop}
				.group-item
					label.inner-label(for="filterSubject") Lọc theo môn học
					select.inner-select#filterSubject
						option(value="") Tất cả môn học
						each item in subjects
							option(value=item.maMonHoc) #{item.maMonHoc} - #{item.tenMonHoc}
				.group-item
					label.inner-label(for="filterLevel") Lọc theo trình độ
					select.inner-select#filterLevel
						option(value="") Tất cả trình độ
						option(value="A") A
						option(value="B") B
						option(value="C") C
				.filter-actions
					button.inner-button.inner-button-primary#btnApplyFilters(type="button") Áp dụng
					button.inner-button#btnClearFilters(type="button") Xóa lọc
			.filter-summary#filterSummary
				span.material-symbols-outlined filter_list
				span Chưa áp dụng bộ lọc
		.table-2
			table
				thead
					tr
						th Lớp
						th Môn học
						th Trình độ
						th Lần
						th Số câu
						th Ngày giờ thi
						th Phút
						th Trạng thái
						th Giảng viên
				tbody#recordsTableBody
					tr
						td(colspan="9") Đang tải dữ liệu...
		.inner-pagination
			p.inner-pagination-text Đang tải 0 đăng ký
			.inner-pagination-buttons
				button.inner-page-button#btnPrevPage(type="button")
					span.material-symbols-outlined chevron_left
				.inner-page-list#pageList
				button.inner-page-button#btnNextPage(type="button")
					span.material-symbols-outlined chevron_right

block scripts
	script(src="/lecturer/assets/js/exam-registration.js")
