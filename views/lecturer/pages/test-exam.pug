extends ../layouts/default.pug

block main
	.section-3
		.inner-head
			h2.inner-title-main
				span.inner-dot
				span THI THỬ (LECTURER SIMULATOR)

		.inner-wrap(style="padding: 30px; background: #fff; border-radius: 12px; margin-top: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); max-width: 600px;")
			h3(style="margin-top: 0; color: #2d3748; font-size: 1.35rem; font-weight: 600; margin-bottom: 8px;") Cấu hình đề thi thử
			p(style="color: #718096; margin-bottom: 24px; font-size: 0.95rem;") Thiết lập các thông số dưới đây để sinh đề thi thử nghiệm trực tiếp từ ngân hàng câu hỏi.

			form(action="/lecturer/test-exam/start" method="POST")
				.group-item(style="margin-bottom: 20px;")
					label.inner-label(for="subjectSelect" style="display: block; font-weight: 600; margin-bottom: 8px; color: #4a5568;")
						| Chọn môn học
						span.inner-required(style="color: red; margin-left: 4px;") *
					select.inner-select(
						id="subjectSelect"
						name="maMonHoc"
						required
						style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 1rem; color: #4a5568;"
					)
						option(value="") -- Chọn môn học --
						if subjects && subjects.length
							each sub in subjects
								option(value=sub.MAMH) #{sub.TENMH} (#{sub.MAMH})

				.group-item(style="margin-bottom: 20px;")
					label.inner-label(for="trinhDoSelect" style="display: block; font-weight: 600; margin-bottom: 8px; color: #4a5568;")
						| Trình độ đề thi
						span.inner-required(style="color: red; margin-left: 4px;") *
					select.inner-select(
						id="trinhDoSelect"
						name="trinhDo"
						required
						style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 1rem; color: #4a5568;"
					)
						option(value="A") Trình độ A (70% A, 30% B)
						option(value="B") Trình độ B (70% B, 30% C)
						option(value="C") Trình độ C (100% C)

				.group-item(style="margin-bottom: 20px; display: flex; gap: 20px;")
					div(style="flex: 1;")
						label.inner-label(for="soCauInput" style="display: block; font-weight: 600; margin-bottom: 8px; color: #4a5568;")
							| Số câu hỏi
							span.inner-required(style="color: red; margin-left: 4px;") *
						input.inner-input(
							type="number"
							id="soCauInput"
							name="soCauThi"
							min="10"
							max="100"
							value="40"
							required
							style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 1rem; color: #4a5568;"
						)
					div(style="flex: 1;")
						label.inner-label(for="thoiGianInput" style="display: block; font-weight: 600; margin-bottom: 8px; color: #4a5568;")
							| Thời gian thi (phút)
							span.inner-required(style="color: red; margin-left: 4px;") *
						input.inner-input(
							type="number"
							id="thoiGianInput"
							name="thoiGian"
							min="5"
							max="180"
							value="45"
							required
							style="width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 1rem; color: #4a5568;"
						)

				button.inner-button-primary(
					type="submit"
					style="margin-top: 10px; background: #3182ce; color: #fff; border: none; padding: 12px 24px; border-radius: 6px; font-weight: 600; font-size: 1rem; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s;"
				)
					span.material-symbols-outlined(style="font-size: 1.25rem;") play_arrow
					| Bắt đầu thi thử

	script.
		document.querySelector('form').addEventListener('submit', async (e) => {
			e.preventDefault();
			const form = e.target;
			const submitBtn = form.querySelector('button[type="submit"]');
			submitBtn.disabled = true;
			submitBtn.innerHTML = '<span class="material-symbols-outlined">sync</span> Đang tạo đề...';

			try {
				const formData = new FormData(form);
				const payload = {};
				formData.forEach((value, key) => { payload[key] = value; });

				const response = await fetch(form.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload)
				});

				if (!response.ok) {
					const errText = await response.text();
					throw new Error(errText || 'Có lỗi xảy ra khi tạo đề.');
				}

				const result = await response.json();
				if (result.success) {
					localStorage.setItem('trial_exam_questions', JSON.stringify(result.questions));
					localStorage.setItem('trial_exam_info', JSON.stringify(result.info));
					localStorage.setItem('trial_exam_start_time', new Date().toISOString());
					localStorage.removeItem('trial_answers');
					window.location.href = '/lecturer/test-exam/take';
				} else {
					alert(result.message || 'Lỗi không xác định.');
					submitBtn.disabled = false;
					submitBtn.innerHTML = '<span class="material-symbols-outlined">play_arrow</span> Bắt đầu thi thử';
				}
			} catch (err) {
				alert(err.message);
				submitBtn.disabled = false;
				submitBtn.innerHTML = '<span class="material-symbols-outlined">play_arrow</span> Bắt đầu thi thử';
			}
		});