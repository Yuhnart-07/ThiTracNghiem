//- BẢN PUG ĐÃ ĐƯỢC THIẾT KẾ ĐẠT CHUẨN CLASS (container, inner-wrap, inner-image, inner-button)
doctype html
html(lang="vi")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title ExamCore Pro Simulator
    link(rel="stylesheet" href="style.css")
  body.exam-container
    //- Header Nav Bar
    header.header-bar
      div.header-left
        div.student-avatar
          img(src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=128" alt="Alexander")
        div.student-info
          h1 Alexander Hamilton
          p ID: CS-404 | EXAMCORE PRO
      div.header-right
        div.timer-display
          span#time-counter 00:45:00
        button.inner-button-primary.btn-submit Submit Exam

    //- Main Dynamic Wrap Container
    div.inner-wrap
      //- Left Navigator panel area
      aside.sidebar-nav
        div.section-meta
          h2 Section A: Core Logic
          p 40 Questions Total
        div.questions-scroll-grid
          div.digits-grid
            - for (var x = 1; x <= 40; x++)
              button.q-digit(class=(x == 12 ? 'active' : ''))= x
        div.sidebar-utils
          button.btn-util#open-calc Máy tính bỏ túi
          button.btn-util#open-rules Hướng dẫn thi

      //- Main Workspace screen
      main.central-workspace
        div.question-card
          div.card-header
            span.badge Question 12 of 40
            button.btn-flag Mark for Review
          div.card-body
            h2 According to the "Kinetic Ledger" design philosophy, how should structural boundaries be established...
            
            //- Graphic diagram visual component
            div.inner-image-container
              svg(viewBox="0 0 800 240")
                //- Drawing blueprint schematic SVGs in here
            
            //- Multiple choice alternatives group list
            div.options-group
              label.option-row
                input(type="radio" name="option")
                span.option-index A
                span.option-text By using 1px solid black borders...
              label.option-row.checked
                input(type="radio" name="option" checked)
                span.option-index B
                span.option-text Through intentional tonal shifts...




