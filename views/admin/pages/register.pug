extends ../layouts/account.pug
include ../mixins/checkbox.pug


block main 
  .form-account
    h1.inner-title Đăng ký
    .inner-desc Tạo một tài khoản để tiếp tục
    form.inner-form(id="registerForm")
      .inner-group
        label.inner-label(for="fullName") Họ tên *
        input.inner-control(
          type="text"
          id="fullName"
          name="fullName"
          placeholder="Ví dụ: Lê Văn A"
        )
      .inner-group
        label.inner-label(for="email") Email *
        input.inner-control(
          type="email"
          id="email"
          name="email"
          placeholder="Ví dụ: levana@gmail.com"
        )
      .inner-group
        label.inner-label(for="password") Mật khẩu *
        input.inner-control(
          type="password"
          id="password"
          name="password"
        )
      .inner-meta
        .inner-check
          +checkbox-30("agree", "agree")
          label(for="agree") Tôi chấp nhân các điều khoản và điều kiện
      button.inner-button Đăng ký
      .inner-more
        span Bạn đã có tài khoản?
        a(href=`/${pathAdmin}/account/login`) Đăng nhập
