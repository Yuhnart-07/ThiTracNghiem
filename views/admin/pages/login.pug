extends ../layouts/account.pug
include ../mixins/checkbox.pug


block main 
  .form-account
    h1.inner-title Đăng nhập
    .inner-desc Khung giao diện đăng nhập, chưa xử lý auth/phân quyền ở Phase 1
    form.inner-form(id="loginForm")
      .inner-group
        label.inner-label(for="role") Vai trò
        select.inner-control(id="role" name="role")
          option(value="PGV") PGV
          option(value="Giangvien") Giảng viên
          option(value="Sinhvien") Sinh viên
      .inner-group
        label.inner-label(for="email") Login / Mã SV
        input.inner-control(
          type="text"
          id="email"
          name="email"
          placeholder="Ví dụ: TH123 hoặc MASV"
        )
      .inner-group
        label.inner-label(for="password") Mật khẩu
        input.inner-control(
          type="password"
          id="password"
          name="password"
        )
      button.inner-button(type="button") Đăng nhập
