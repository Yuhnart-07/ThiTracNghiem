extends ../layouts/account.pug
include ../mixins/checkbox.pug

block title 
  title Đổi mật khẩu

block main 
  .form-account
    h1.inner-title Đổi mật khẩu
    .inner-desc Vui lòng nhập mật khẩu để tiếp tục
    form.inner-form(id="changePasswordForm")
      .inner-group
        label.inner-label(for="newPassword") Mật khẩu mới
        input.inner-control(
          type="password"
          id="newPassword"
          name="newPassword"
        )
      .inner-group
        label.inner-label(for="confirmPassword") Xác nhận mật khẩu
        input.inner-control(
          type="password"
          id="confirmPassword"
          name="ConfirmPassword"
        )
      button.inner-button Thay đổi
      .inner-more
        span Bạn đã nhớ mật khẩu?
        a(href="#") Đăng nhập
