extends ../layouts/default.pug
include ../mixins/checkbox.pug

block title
	title Tạo tour

block main
	h1.box-title Tạo tour

	.section-8
		form(id = "tour-create-form")
			.inner-group
				label.inner-label(for="name") Tên tour * 
				input(type="text" id="name" name="name")

			.inner-group
				label.inner-label(for="category") Danh mục
				select(id="category" name="category")
					option(value="") -- Chọn danh mục --
					option(value="id-danh-muc-1") Danh mục 1
					option(value="id-danh-muc-2") Danh mục 2

			.inner-group
				label.inner-label(for="position") Vị trí
				input(type="number" id="position" name="position")

			.inner-group
				label.inner-label(for="status") Trạng thái
				select(id="status" name="status")
					option(value="active") Hoạt động
					option(value="inactive") Tạm dừng

			.inner-group.inner-two-col
				label.inner-label(for="avatar") Ảnh đại diện
				.inner-upload-image 
					input(type="file" id="avatar" name="avatar" filepond-image)
			.inner-group
				label.inner-label Giá cũ
				.inner-input-list
					.inner-input-item
						label(for="priceOldAdult") Người lớn
						input(type="number" id="priceOldAdult" name="priceOldAdult")
					.inner-input-item
						label(for="priceOldChildren") Trẻ em
						input(type="number" id="priceOldChildren" name="priceOldChildren")
					.inner-input-item
						label(for="priceOldBaby") Em bé
						input(type="number" id="priceOldBaby" name="priceOldBaby")

			.inner-group
				label.inner-label Giá mới
				.inner-input-list
					.inner-input-item
						label(for="priceNewAdult") Người lớn
						input(type="number" id="priceNewAdult" name="priceNewAdult")
					.inner-input-item
						label(for="priceNewChildren") Trẻ em
						input(type="number" id="priceNewChildren" name="priceNewChildren")
					.inner-input-item
						label(for="priceNewBaby") Em bé
						input(type="number" id="priceNewBaby" name="priceNewBaby")

			.inner-group
				label.inner-label Còn lại
				.inner-input-list
					.inner-input-item
						label(for="stockAdult") Người lớn
						input(type="number" id="stockAdult" name="stockAdult")
					.inner-input-item
						label(for="stockChildren") Trẻ em
						input(type="number" id="stockChildren" name="stockChildren")
					.inner-input-item
						label(for="stockBaby") Em bé
						input(type="number" id="stockBaby" name="stockBaby")

			.inner-group
				label.inner-label Những địa điểm có tour
				.inner-checkbox-list
					.inner-checkbox-item
						+checkbox-30("locations", "location-1", "id-ha-noi")
						label(for="location-1") Hà Nội
					.inner-checkbox-item
						+checkbox-30("locations", "location-2", "id-da-nang")
						label(for="location-2") Đà Nẵng
					.inner-checkbox-item
						+checkbox-30("locations", "location-3", "id-nha-trang")
						label(for="location-3") Nha Trang
					.inner-checkbox-item
						+checkbox-30("locations", "location-4", "id-tphcm")
						label(for="location-4") Thành phố Hồ Chí Minh

			.inner-group
				label.inner-label(for="time") Thời gian
				input(type="text" id="time" name="time")

			.inner-group
				label.inner-label(for="vehicle") Phương tiện đi lại
				input(type="text" id="vehicle" name="vehicle")

			.inner-group
				label.inner-label(for="departureDate") Ngày khởi hành
				input(type="date" id="departureDate" name="departureDate")

			.inner-group.inner-two-col
				label.inner-label(for="information") Thông tin tour
				textarea(id="information" name="information" textarea-mce)
			.inner-group.inner-two-col
				label.inner-label(for="information") Lịch trình tour
				.inner-schedule 
					.inner-schedule-list 
						.inner-schedule-item
							.inner-schedule-head 
								.inner-schedule-button.inner-move
									<i class="fa-solid fa-arrows-up-down-left-right"></i>
								input(type="text")
								.inner-schedule-button.inner-remove
									<i class="fa-solid fa-trash-can"></i>
								.inner-schedule-button.inner-more
									<i class="fa-solid fa-angle-down"></i>
							.inner-schedule-body
								textarea(textarea-mce)
					.inner-schedule-create + Thêm lịch trình
			.inner-button.inner-two-col
				button Tạo mới

		.inner-back
			a(href="#") Quay lại danh sách
