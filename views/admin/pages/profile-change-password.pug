extends ../layouts/default.pug

block title
	title Đổi mật khẩu

block main
	h1.box-title Đổi mật khẩu

	.section-8
		form(id="profile-change-password-form")
			.inner-group
				label.inner-label(for="newpw") Mật khẩu mới
				input(type="text" id="newpw" name="newpw")
			.inner-group
				label.inner-label(for="confirm-newpw") Nhập lại mật khẩu mới
				input(type="text" id="confirm-newpw" name="confirm-newpw")
			.inner-button.inner-two-col
				button Đổi mật khẩu
