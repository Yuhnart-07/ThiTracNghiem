extends ../layouts/default.pug
include ../mixins/checkbox.pug


block main
	h1.box-title Quản lý tour

	//- SECTION 4
	.section-4
		.inner-wrap
			.inner-item.inner-label
				<i class="fa-solid fa-filter"></i> Bộ lọc
			.inner-item
				select
					option(value="") Trạng thái
					option(value="") Hoạt động
					option(value="") Tạm dừng
			.inner-item
				select
					option(value="") Người tạo
					option(value="") Lê Văn A
					option(value="") Nguyễn Thị B
			.inner-item
				select
					option(value="") Danh mục
					option(value="") Danh mục 1
					option(value="") Danh mục 2
			.inner-item
				select
					option(value="") Mức giá
					option(value="") Dưới 1tr
					option(value="") Từ 1tr - 2tr
					option(value="") Từ 2tr - 6tr
					option(value="") Trên 6tr
			.inner-item.inner-date
				input(type="date")
				span -
				input(type="date")
			.inner-item.inner-reset
				<i class="fa-solid fa-arrow-rotate-left"></i> Xóa bộ lọc
	//- END SECTION 4

	//- SECTION 5
	.section-5
		.inner-wrap
			.inner-change-status
				.inner-item
					select
						option(value="") -- Hành động --
						option(value="") Hoạt động
						option(value="") Dừng hoạt động
						option(value="") Xóa
				.inner-item
					button Áp dụng
			.inner-search
				<i class="fa-solid fa-magnifying-glass"></i>
				input(type="text" placeholder="Tìm kiếm")
			.inner-button-create
				a(href=`/${pathAdmin}/tour/create`) + Tạo mới
			.inner-button-trash
				a(href=`/${pathAdmin}/tour/trash`) Thùng rác
	//- END SECTION 5

	//- SECTION 6
	.section-6
		.table-2
			table
				thead
					tr
						th.text-left
							+checkbox-30("", "")
						th.text-left Tên tour
						th.text-center Ảnh đại diện
						th.text-left Giá
						th.text-left Còn lại
						th.text-center Vị trí
						th.text-center Trạng thái
						th.text-left Tạo bởi
						th.text-left Cập nhật bởi
						th.text-left Hành động
				tbody
					tr
						td.text-left
							+checkbox-30("", "")
						td.text-left Tour Hạ Long
						td.text-center
							img.inner-avatar(src="/admin/assets/images/tour.png", alt="")
						td.text-left 
							div NL: 1.900.000đ
							div TE: 1.600.000đ
							div EB: 1.000.000đ
						td.text-left 
							div NL: 30
							div TE: 20
							div EB: 10
						td.text-center 1
						td.text-center
							.tag.tag-orange Hoạt động
						td.text-left
							div Lê Văn A
							div.inner-small 16:30 - 20/10/2024
						td.text-left
							div Nguyễn Văn B
							div.inner-small 09:15 - 22/10/2024
						td.text-left
							.box-actions
								a.inner-edit(href="#")
									<i class="fa-regular fa-pen-to-square"></i>
								a.inner-remove(href="#")
									<i class="fa-regular fa-trash-can"></i>
					
	//- END SECTION 6

	//- SECTION 7
	.section-7
		div.inner-label Hiển thị 1 - 9 của 78
		select.inner-pagination
			option(value="") Trang 1
			option(value="") Trang 2
			option(value="") Trang 3
	//- END SECTION 7
