extends ../layouts/default.pug


block main
	h1.box-title Thông tin website

	.section-8
		form(id="setting-website-info-form")
			.inner-group
				label.inner-label(for="nameWeb") Tên website *
				input(type="text" id="nameWeb" name="nameWeb" value="Lê Văn A")
			.inner-group
				label.inner-label(for="phone") Số điện thoại
				input(type="number" id="phone" name="phone" value="0123456789")
			.inner-group
				label.inner-label(for="email") Email
				input(type="email" id="email" name="email" value="levana@gmail.com")
			.inner-group
				label.inner-label(for="address") Địa chỉ
				input(type="text" id="address" name="address" value="Số 123, đường ABC")
			.inner-group
				label.inner-label(for="logo") Logo
				.inner-upload-image 
					input(type="file" id="logo" name="logo" filepond-image)
			.inner-group
				label.inner-label(for="favicon") Favicon
				.inner-upload-image 
					input(type="file" id="favicon" name="favicon" filepond-image)
			.inner-button.inner-two-col
				button Cập nhật
		.inner-back
			a(href=`/${pathAdmin}/setting/list`) Quay lại danh sách
