extends ../layouts/default.pug

block main
	h1.box-title Them #{module.title.toLowerCase()}

	.section-8
		form
			each field in module.fields
				.inner-group
					label.inner-label(for=field.name) #{field.label} (#{field.name})
					if field.name == "NOIDUNG"
						textarea(id=field.name name=field.name rows="4" disabled placeholder=`${field.type} - Se xu ly CRUD o phase sau`)
					else
						input(id=field.name name=field.name type="text" disabled placeholder=`${field.type} - Se xu ly CRUD o phase sau`)
			.inner-button
				button(type="button" disabled) Ghi
			.inner-back
				a(href=`/${pathAdmin}/${module.key}/list`) Quay lai danh sach
