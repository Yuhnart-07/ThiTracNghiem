extends ../layouts/default.pug


block main
	h1.box-title Đơn hàng: OD000001

	.section-8
		form(id="order-edit-form")
			.inner-group
				label.inner-label(for="fullName") Tên khách hàng *
				input(type="text" id="fullName" name="fullName" value="Lê Văn A")
			.inner-group
				label.inner-label(for="phone") Số điện thoại *
				input(type="number" id="phone" name="phone" value="0123456789")
			.inner-group.inner-two-col
				label.inner-label(for="note") Ghi chú
				textarea(id="note" name="note")
			.inner-group
				label.inner-label(for="paymentMethod") Phương thức thanh toán
				select(id="paymentMethod" name="paymentMethod")
					option(value="cash") Tiền mặt
					option(value="momo") Ví momo
					option(value="bank") Chuyển khoản
					option(value="zalopay") ZaloPay
					option(value="vnpay") VN Pay
			.inner-group
				label.inner-label(for="paymentStatus") Trạng thái thanh toán
				select(id="paymentStatus" name="paymentStatus")
					option(value="paid") Chưa thanh toán
					option(value="unpaid") Đã thanh toán
			.inner-group
				label.inner-label Ngày đặt
				input(type="text" value="16:30 - 01/01/2024" readonly)
			.inner-group
				label.inner-label(for="status") Trạng thái 
				select(id="status" name="status")
					option(value="initital") Khởi tạo
					option(value="done") Đã duyệt
					option(value="cancel") Đã hủy
			.inner-group
				label.inner-label Danh sách tour 
				.inner-order-list 
					.inner-order-item 
						.inner-order-image 
							img(src="/admin/assets/images/tour.png", alt="")
						.inner-order-content 
							.inner-order-name Tour Hạ Long 
							.inner-order-text Người lớn: 3 x 1.500.000đ
							.inner-order-text Trẻ em: 2 x 1.300.000đ
							.inner-order-text Em bé: 2 x 1.000.000đ
							.inner-order-text Ngày khởi hành: 20/10/2024
							.inner-order-text Khởi hành tại: Hà Nội
					.inner-order-item 
						.inner-order-image 
							img(src="/admin/assets/images/tour.png", alt="")
						.inner-order-content 
							.inner-order-name Tour Hạ Long 
							.inner-order-text Người lớn: 3 x 1.500.000đ
							.inner-order-text Trẻ em: 2 x 1.300.000đ
							.inner-order-text Em bé: 2 x 1.000.000đ
							.inner-order-text Ngày khởi hành: 20/10/2024
							.inner-order-text Khởi hành tại: Hà Nội
			.inner-group
				label.inner-label Thanh toán 
				.inner-order-total 
					div Tổng tiền: 10.000.000đ
					div Giảm: 400.000đ
					vid Mã giảm: TOURMUAHE2024
					div Thanh toán <span class ="inner-order-price"> 9.600.000đ </span>
					
			.inner-button.inner-two-col
				button Cập nhật
		.inner-back
			a(href=`/${pathAdmin}/order/list`) Quay lại danh sách
