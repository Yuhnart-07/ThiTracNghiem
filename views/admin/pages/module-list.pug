extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
	h1.box-title #{module.pageTitle}

	.section-4
		.inner-wrap
			.inner-item.inner-label
				<i class="fa-solid fa-database"></i> #{module.tableName}
			.inner-item
				span Khoa chinh: #{module.primaryKey}
			.inner-item
				span Duong dan: /#{pathAdmin}#{module.routeBase}
			.inner-item
				span #{module.note}

	.section-5
		.inner-wrap
			.inner-change-status
				.inner-item
					select(disabled)
						option(value="") -- Chuc nang Phase 2 --
				.inner-item
					button(type="button" disabled) Ap dung
			.inner-search
				<i class="fa-solid fa-magnifying-glass"></i>
				input(type="text" placeholder="Tim kiem" disabled)
			if module.actions.includes("create")
				.inner-button-create
					a(href=`/${pathAdmin}/${module.key}/create`) + Tao moi

	.section-6
		.table-2
			table
				thead
					tr
						th.text-left
							+checkbox-30("", "")
						each field in module.fields
							th.text-left #{field.name}
						th.text-left Hanh dong
				tbody
					tr
						td.text-left
							+checkbox-30("", "")
						each field in module.fields
							td.text-left Chua nap du lieu
						td.text-left
							a(href=`/${pathAdmin}/${module.key}/detail`) Xem skeleton

	.section-7
		div.inner-label Phase 2 chi chuan hoa module/route/view. CRUD va query du lieu se lam o phase sau.
		if module.gaps && module.gaps.length
			ul
				each gap in module.gaps
					li #{gap}
