extends ../layouts/default.pug

block title
	title Tạo tài khoản quản trị

block main
	h1.box-title Tạo tài khoản quản trị

	.section-8
		form(id="setting-account-admin-create-form")
			.inner-group
				label.inner-label(for="name") Họ tên *
				input(type="text" id="name" name="name" value="Lê Văn A")
			.inner-group
				label.inner-label(for="email") Email *
				input(type="email" id="email" name="email" value="levana@gmail.com")
			.inner-group
				label.inner-label(for="phone") Số điện thoại
				input(type="number" id="phone" name="phone" value="0123456789")
			.inner-group
				label.inner-label(for="usergear") Nhóm quyền
				select(id="usergear" name="usergear")
					option(value="id-quan-tri-vien") Quản trị viên
					option(value="id-quan-ly-tour") Quản lý tour
					option(value="id-quan-ly-don-hang") Quản lý đơn hàng
			.inner-group
				label.inner-label(for="position") Chức vụ *
				input(type="text" id="position" name="position" value="Giám đốc")
			.inner-group
				label.inner-label(for="status") Trạng thái
				select(id="status" name="status")
					option(value="active") Hoạt động
					option(value="inactive") Tạm dừng
			.inner-group
				label.inner-label(for="password") Mật khẩu *
				input(type="text" id="password" name="password" value="123456")
			.inner-group.inner-two-col
				label.inner-label(for="avatar") Ảnh đại diện
				.inner-upload-image 
					input(type="file" id="avatar" name="avatar" filepond-image)
			.inner-button.inner-two-col
				button Tạo mới
		.inner-back
			a(href="#") Quay lại danh sách
