extends ../layouts/default.pug
include ../mixins/crud.pug
include ../mixins/checkbox.pug

block main
	// ALERT MESSAGE
	.inner-message-alert(id="alertMessage" style="display:none; padding: 12px; margin-bottom: 15px; border-radius: 6px; font-weight: 500;")

	// FORM
	.section-1.cols-2
		form.inner-form(id="subjectForm" data-api-base="/admin/subject-management")
			.inner-wrap
				.group-item
					label.inner-label(for="subjectCode")
						| Mã môn học 
						span.inner-required *

					input.inner-control(
						type="text"
						id="subjectCode"
						name="subjectCode"
						placeholder="e.g. CS101"
					)

					p.inner-help
						| Yêu cầu mã môn duy nhất *

				.group-item
					label.inner-label(for="subjectName")
						| Tên môn học 
						span.inner-required *

					input.inner-control(
						type="text"
						id="subjectName"
						name="subjectName"
						placeholder="e.g. Advanced Algorithms"
					)


	+crud()

	// TABLE
	.section-3
		.inner-head
			h2.inner-title-main
				span.inner-dot
				span DANH SÁCH MÔN HỌC

			.inner-tools
				.inner-filter
					span.material-symbols-outlined
						| search

					input.inner-filter-input(
						type="text"
						id="tableFilter"
						placeholder="Tìm kiếm..."
					)

		.table-2
			table
				thead
					tr
						th.text-left(style="width: 50px;")
							+checkbox-30("checkAllSubjects", "checkAllSubjects", "all")
						th.text-left Mã môn học
						th.text-left Tên môn học
				tbody#recordsTableBody
					tr
						td(colspan="3" style="text-align: center; padding: 20px; color: #a0aec0;") Đang tải danh sách môn học...

		// PAGINATION
		.inner-pagination
			p.inner-pagination-text(id="paginationText")
				| Displaying 0 of 0 records

			.inner-pagination-buttons
				button.inner-page-button(
					type="button"
					id="btnPrevPage"
				)
					span.material-symbols-outlined
						| chevron_left

				.inner-page-list(
					id="pageList"
				)

				button.inner-page-button(
					type="button"
					id="btnNextPage"
				)
					span.material-symbols-outlined
						| chevron_right

	// IMPORT SCRIPTS
	script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
	link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
	script(src="/admin/assets/js/subject-management.js")