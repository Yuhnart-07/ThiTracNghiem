extends ../layouts/default.pug

block title 
  title Tổng quan 

block main 
  h1.box-title Tổng quan

  //- SECTION 1
  .section-1
    .inner-item 
      .inner-icon
        img(src="assets/images/Icon.svg", alt="")
      .inner-content 
        .inner-title Người dùng
        .inner-number 1.200
    .inner-item 
      .inner-icon
        img(src="assets/images/Icon-1.svg", alt="")
      .inner-content 
        .inner-title Đơn hàng
        .inner-number 3.600
    .inner-item 
      .inner-icon
        img(src="assets/images/Icon-2.svg", alt="")
      .inner-content 
        .inner-title Doanh thu
        .inner-number 300.000.000đ
  //- END SECTION 1


  //- SECTION 2
  .section-2 
    .inner-head 
      h2.inner-title Biểu đồ doanh thu 
      input.inner-filter(type="month")
    .inner-chart 
      canvas(id = "revenue-chart")
  //- END SECTION 2


  //- SECION 3 
  .section-3 
    h2.inner-title-main Đơn hàng mới 

    .table-1 
      table 
        thead 
          tr 
            th.text-left Mã
            th.text-left Thông tin khách hàng
            th.text-left Danh sách tour
            th.text-left Thanh toán 
            th.text-left Trạng thái
            th.text-right Ngày đặt
        tbody 
          tr 
            td.text-left
              .text-primary OD000001
            td.text-left
              div Họ tên: Lê Văn A
              div SDT: 0123456789
              div Ghi chú: Test...
            td.text-left
              .tour-list  
                .tour-item 
                  img.inner-image(src="assets/images/tour.png", alt="")
                  .inner-content 
                    .inner-name Tour Hạ Long 
                    .inner-desc 
                      div Người lớn: 3 x 1.500.000đ
                      div Trẻ em: 2 x 1.300.000đ
                      div Em bé: 2 x 1.000.000đ
                .tour-item 
                  img.inner-image(src="assets/images/tour.png", alt="")
                  .inner-content 
                    .inner-name Tour Hạ Long 
                    .inner-desc 
                      div Người lớn: 3 x 1.500.000đ
                      div Trẻ em: 2 x 1.300.000đ
                      div Em bé: 2 x 1.000.000đ
            td.text-left
              div Tổng tiền: 10.000.000đ
              div Giảm: 400.000đ
              div Mã giảm: TOURMUAHE2024
              div Thanh toán: 9.600.000đ
              div PTTT: Ví Momo
              div TTTT: Đã thanh toán
            td.text-left
              .tag.tag-orange Khởi tạo 
            td.text-right
              div 16:20
              div 01/01/2024

  //- END SECTION 3