extends ../layouts/default.pug

block main
  h1.box-title Tong quan he thong thi trac nghiem

  .section-1
    .inner-item
      .inner-icon
        i.fa-solid.fa-book
      .inner-content
        .inner-title Mon hoc
        .inner-number MONHOC
    .inner-item
      .inner-icon
        i.fa-solid.fa-user-graduate
      .inner-content
        .inner-title Sinh vien
        .inner-number SINHVIEN
    .inner-item
      .inner-icon
        i.fa-solid.fa-circle-question
      .inner-content
        .inner-title Bo de
        .inner-number BODE

  .section-3
    h2.inner-title-main Cac module theo THITRACNGHIEM.sql
    .table-2
      table
        thead
          tr
            th.text-left Module
            th.text-left Bang SQL
            th.text-left Trang quan ly
        tbody
          each item in modules
            tr
              td.text-left #{item.label}
              td.text-left
                .text-primary #{item.table}
              td.text-left
                a(href=`/${pathAdmin}/${item.key}/list`) Mo module
