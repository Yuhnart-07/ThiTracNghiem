extends ../layouts/default.pug

block main
  h1.box-title Tong quan he thong thi trac nghiem

  .section-1
    each item in modules.slice(0, 3)
      .inner-item
        .inner-icon
          i(class=item.icon)
        .inner-content
          .inner-title #{item.title}
          .inner-number #{item.tableName}

  .section-3
    h2.inner-title-main Cac module theo THITRACNGHIEM.sql
    .table-2
      table
        thead
          tr
            th.text-left Module
            th.text-left Bang SQL
            th.text-left Khoa chinh
            th.text-left Pham vi nhom
            th.text-left Trang quan ly
        tbody
          each item in modules
            tr
              td.text-left #{item.title}
              td.text-left
                .text-primary #{item.tableName}
              td.text-left #{item.primaryKey}
              td.text-left #{item.ownerHint}
              td.text-left
                a(href=`/${pathAdmin}/${item.key}/list`) Mo module

  .section-3
    h2.inner-title-main Ghi chu can chot
    .table-2
      table
        thead
          tr
            th.text-left Module
            th.text-left Ghi chu
        tbody
          each item in modules
            if item.gaps && item.gaps.length
              each gap in item.gaps
                tr
                  td.text-left #{item.title}
                  td.text-left #{gap}
