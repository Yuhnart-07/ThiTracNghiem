extends ../layouts/default.pug
include ../mixins/crud.pug
include ../mixins/checkbox.pug

block main
	// ALERT MESSAGE
	.inner-message-alert(id="alertMessage" style="display:none; padding: 12px; margin-bottom: 15px; border-radius: 6px; font-weight: 500;")

	// FORM
	.section-1
		form.inner-form(id="lecturerForm" data-api-base="/admin/lecturer-management")
			.inner-wrap
				.group-item
					label.inner-label(for="lecturerCode")
						| Mã giáo viên 
						span.inner-required *

					input.inner-control(
						type="text"
						id="lecturerCode"
						name="lecturerCode"
						placeholder="e.g. GV001"
					)

					p.inner-help
						| Yêu cầu mã giảng viên duy nhất *

				.group-item
					label.inner-label(for="last-name")
						| Họ 
						span.inner-required *

					input.inner-control(
						type="text"
						id="last-name"
						name="lastName"
						placeholder="Nguyễn Văn"
					)
				.group-item
					label.inner-label(for="first-name")
						| Tên 
						span.inner-required *

					input.inner-control(
						type="text"
						id="first-name"
						name="firstName"
						placeholder="Bình"
					)
				.group-item
					label.inner-label(for="phone")
						| SDT 
						span.inner-required *

					input.inner-control(
						type="text"
						id="phone"
						name="phone"
						placeholder="0987654321"
					)
				.group-item
					label.inner-label(for="address")
						| Địa chỉ 
						span.inner-required *

					input.inner-control(
						type="text"
						id="address"
						name="address"
						placeholder="Quận 1, TP. HCM"
					)
				
	+crud()

	// TABLE
	.section-3
		.inner-head
			h2.inner-title-main
				span.inner-dot
				span DANH SÁCH GIÁO VIÊN

			.inner-tools
				.inner-filter
					span.material-symbols-outlined
						| search

					input.inner-filter-input(
						type="text"
						id="tableFilter"
						placeholder="Tìm kiếm..."
					)

		.table-2
			table
				thead
					tr
						th.text-left(style="width: 50px;")
							+checkbox-30("checkAllLecturers", "checkAllLecturers", "all")
						th.text-left Mã giáo viên 
						th.text-left Họ 
						th.text-left Tên
						th.text-left SDT
						th.text-left Địa chỉ
						th.text-right Hành động

				tbody#recordsTableBody
					tr
						td(colspan="7" style="text-align: center; padding: 20px; color: #a0aec0;") Đang tải danh sách giảng viên...

		// PAGINATION
		.inner-pagination
			p.inner-pagination-text(id="paginationText")
				| Displaying 0 of 0 records

			.inner-pagination-buttons
				button.inner-page-button(
					type="button"
					id="btnPrevPage"
				)
					span.material-symbols-outlined
						| chevron_left

				.inner-page-list(
					id="pageList"
				)

				button.inner-page-button(
					type="button"
					id="btnNextPage"
				)
					span.material-symbols-outlined
						| chevron_right

	// IMPORT SCRIPTS
	script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
	link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
	script(src="/admin/assets/js/lecturer-management.js")