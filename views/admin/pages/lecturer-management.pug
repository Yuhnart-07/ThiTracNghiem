extends ../layouts/default.pug
include ../mixins/crud.pug

block main
	// FORM
	.section-1
		form.inner-form(id="lecturerForm")
			.inner-wrap
				.group-item
					label.inner-label(for="lecturerCode")
						| Mã giáo viên 
						span.inner-required *

					input.inner-control(
						type="text"
						id="lecturerCode"
						name="lecturerCode"
						placeholder="e.g. CS101"
					)

					p.inner-help
						| Yêu cầu mã giảng viên duy nhất *

				.group-item
					label.inner-label(for="last-name")
						| Họ 
						span.inner-required *

					input.inner-control(
						type="text"
						id="last-name"
						name="last-name"
					)
				.group-item
					label.inner-label(for="first-name")
						| Tên 
						span.inner-required *

					input.inner-control(
						type="text"
						id="first-name"
						name="first-name"
					)
				.group-item
					label.inner-label(for="phone")
						| SDT 
						span.inner-required *

					input.inner-control(
						type="text"
						id="phone"
						name="phone"
					)
				.group-item
					label.inner-label(for="address")
						| Địa chỉ 
						span.inner-required *

					input.inner-control(
						type="text"
						id="address"
						name="address"
					)
				
	+crud()

	// TABLE
	.section-3
		.inner-head
			h2.inner-title-main
				span.inner-dot
				span DANH SÁCH GIÁO VIÊN

			.inner-tools
				.inner-filter
					span.material-symbols-outlined
						| search

					input.inner-filter-input(
						type="text"
						id="tableFilter"
						placeholder="Tìm kiếm..."
					)

				button.inner-filter-button(
					type="button"
				)
					span.material-symbols-outlined
						| filter_list

		.table-2
			table
				thead
					tr
						th.text-left Mã giáo viên 
						th.text-left Họ 
						th.text-left Tên
						th.text-left SDT
						th.text-left Địa chỉ
						th.text-right Hành động

				tbody#recordsTableBody
					//- Render by javascript

		// PAGINATION
		.inner-pagination
			p.inner-pagination-text
				| Displaying 0 of 0 records

			.inner-pagination-buttons
				button.inner-page-button(
					type="button"
					id="btnPrevPage"
				)
					span.material-symbols-outlined
						| chevron_left

				.inner-page-list(
					id="pageList"
				)

				button.inner-page-button(
					type="button"
					id="btnNextPage"
				)
					span.material-symbols-outlined
						| chevron_right